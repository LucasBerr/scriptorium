# Copy to .env and fill in. .env is gitignored and must never be committed.

# LLM provider credentials. Only the provider named in config/models.yaml is required.
OPENAI_API_KEY=

# Optional second provider, used only by evaluation arm B6 (provider comparison).
ANTHROPIC_API_KEY=

# Path to the model/pricing pin file.
SCRIPTORIUM_MODELS_CONFIG=config/models.yaml

# Where the audit log is written. One JSON object per translation.
SCRIPTORIUM_AUDIT_LOG=outputs/audit.jsonl

# Set to 1 to forbid any outbound model call. Used by the test suite and CI.
SCRIPTORIUM_OFFLINE=0
